on property:sys.boot_completed=1
    # System server manages zram writeback limits
    chown root system /sys/block/zram0/writeback_limit
    chmod 0664 /sys/block/zram0/writeback_limit
    chown root system /sys/block/zram0/writeback_limit_enable
    chmod 0664 /sys/block/zram0/writeback_limit_enable

    # System server trigger extend reclaim
    chown root system /sys/kernel/extend_reclaim/reclaim
    chmod 0664 /sys/kernel/extend_reclaim/reclaim

#    trigger swapon_zram

on property:ro.vendor.qti.per_boot_created=1
    swapon_all /vendor/etc/fstab.zram_wb

