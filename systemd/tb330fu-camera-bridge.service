[Unit]
Description=TB330FU Python camera HTTP bridge
Requires=tb330fu-camera-daemon.service
After=tb330fu-camera-daemon.service

[Service]
Type=simple
User=felix
Environment=PYTHONPATH=/usr/local/lib/tb330fu/camera-bridge-deps:/usr/local/lib/tb330fu/camera-bridge
ExecStart=/usr/bin/python3 /usr/local/lib/tb330fu/camera-bridge/camera_bridge.py --listen 127.0.0.1 --port 3909
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
