[Unit]
Description=TB330FU camera JPEG processor
Requires=tb330fu-android-boot-complete.service
After=tb330fu-android-boot-complete.service

[Service]
Type=simple
User=root
ExecStart=/usr/local/lib/tb330fu/tb330fu-camera-processor
NoNewPrivileges=yes
ReadWritePaths=/run/tb330fu-camera
RuntimeDirectory=tb330fu-camera
RuntimeDirectoryMode=0775
ExecStartPre=/usr/bin/install -d -o root -g root -m 0775 /run/tb330fu-camera

[Install]
WantedBy=multi-user.target
