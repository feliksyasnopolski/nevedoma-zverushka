[Unit]
Description=rediska — centralized Android property broker
After=local-fs.target
Before=multi-user.target

[Service]
Type=simple
RuntimeDirectory=tb330fu
RuntimeDirectoryMode=0755
ExecStart=/usr/local/sbin/rediska
Restart=on-failure
RestartSec=1
Environment=TB330FU_REDISKA_SOCKET=/run/tb330fu/rediska.sock
Environment=TB330FU_REDISKA_ADMIN_SOCKET=/run/tb330fu/rediska-admin.sock
Environment=FAKEPROPS_FILE=/var/lib/tb330fu/property-bootstrap/bootstrap.properties

[Install]
WantedBy=multi-user.target
