[Unit]
Description=TB330FU production camera bridge
Requires=tb330fu-camera-module.service tb330fu-video-recorder.service
After=tb330fu-camera-module.service tb330fu-video-recorder.service tb330fu-android-boot-complete.service

[Service]
Type=simple
User=root
SupplementaryGroups=video render
ExecStart=/usr/local/lib/tb330fu/tb330fu-camera-daemon
NoNewPrivileges=yes
ExecStartPre=/usr/bin/install -d -o root -g root -m 0775 /run/tb330fu-camera

[Install]
WantedBy=multi-user.target
