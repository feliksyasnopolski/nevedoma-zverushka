[Unit]
Description=TB330FU raw device node lifecycle manager
RequiresMountsFor=/dev /proc /sys
After=local-fs.target
Before=multi-user.target

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/tb330fu-devd
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
